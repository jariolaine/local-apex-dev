####################################################################################
# ENVIRONMENT VARIABLES CONFIGURATION
#
# INSTRUCTIONS:
# 1. This file defines the core passwords and settings for the environment.
# 2. To change an optional setting, remove the '#' symbol at the start of the line and provide a value.
# 3. Do NOT put spaces around the equals sign (e.g., use KEY=value, NOT KEY = value).
####################################################################################

####################################################################################
# Database & ORDS
####################################################################################

# The master password used for SYS, SYSTEM, and PDBADMIN database users.
# IMPORTANT: Oracle requires strong passwords (e.g., minimum 8 characters,
# at least one uppercase letter, one lowercase letter, and one number).
ORACLE_PWD=

# Sets the delimiter used to separate multiple files in the COMPOSE_FILE variable.
# Keep this set to ':' to ensure cross-platform compatibility.
COMPOSE_PATH_SEPARATOR=:

# Defines which Docker Compose files are loaded and merged on startup.
# Choose ONE of the following options by uncommenting it to add Ollama to the environment.

# Option 1: Database, ORDS, APEX, HTTPS gateway, and Ollama (CPU only).
# COMPOSE_FILE=docker-compose.yml:./compose/ollama.yml

# Option 2: Database, ORDS, APEX, HTTPS gateway, and Ollama (with NVIDIA GPU support).
# COMPOSE_FILE=docker-compose.yml:./compose/ollama.yml:./compose/ollama.cuda.yml

# The IP address and port on the host machine used to access the Oracle Database listener.
# Use 127.0.0.1:1521 for local-only access, or 0.0.0.0:1521 to expose it to your local network.
# HOST_DB_BINDING=127.0.0.1:1521

# The IP address and port on the host machine used to access APEX.
# Use 127.0.0.1:8181 for local-only access, or 0.0.0.0:8181 to expose it to your local network.
# HOST_ORDS_BINDING=127.0.0.1:8181

####################################################################################
# ORDS (Oracle REST Data Services)
####################################################################################

# Set to TRUE to enable verbose logging for ORDS. Useful for troubleshooting.
# DEBUG=FALSE

####################################################################################
# Database Startup Features
####################################################################################

# These settings control advanced database recovery features. For a simple local
# development environment, it is best to leave these as FALSE (commented out)
# to save disk space and resources.

# Set to TRUE to enable ARCHIVELOG mode for database recovery workflows.
# ENABLE_ARCHIVELOG=FALSE

# Set to TRUE to force redo logging even for operations that request NOLOGGING.
# ENABLE_FORCE_LOGGING=FALSE

####################################################################################
# APEX Instance Administration
####################################################################################

# These credentials are used to log into the APEX Administration Service
# (INTERNAL workspace) to manage the entire APEX platform.

# The username for the APEX instance administrator.
# APEX_ADMIN_USER_NAME=ADMIN

# The password for the APEX instance administrator.
# If left commented out, it automatically uses the ORACLE_PWD from above.
# Note: Password must meet Oracle's strong password requirements.
# APEX_ADMIN_USER_PWD=

# The email address associated with the APEX administrator account.
# NOTE: This environment does not provide an SMTP server for sending emails.
#       If you wish to send emails (e.g., for password recovery),
#       you must configure an external SMTP server in the APEX instance settings.
# APEX_ADMIN_USER_EMAIL=

####################################################################################
# Ollama
####################################################################################

# These settings optimize how Large Language Models run on the host hardware.
# Tuning these depends heavily on available RAM/VRAM.

# The maximum context window (in tokens) the model can process at once.
# Note: Larger contexts consume significantly more memory.
# OLLAMA_CONTEXT_LENGTH=8192

# How long a model stays loaded in memory after the last request.
# '1h' keeps it ready for rapid follow-up prompts during development.
# OLLAMA_KEEP_ALIVE=1h

# Enables Flash Attention, which speeds up processing and reduces memory
# usage for large context windows (1 = Enabled, 0 = Disabled).
# OLLAMA_FLASH_ATTENTION=1

# The number of concurrent requests Ollama will process at the same time.
# A value of 1 is a conservative default for local development and reduces memory usage.
# OLLAMA_NUM_PARALLEL=1

# The quantization format used to compress the Key-Value cache in memory.
# f16   - High precision and memory usage.
#
# q8_0  - 8-bit quantization. Uses approximately half the memory of f16 with
#         a very small loss in precision that usually has no noticeable impact on model quality.
#
# q4_0  - 4-bit quantization. Uses approximately one quarter of the memory of
#         f16 with a small to moderate loss in precision that may become more
#         noticeable at larger context sizes.
# OLLAMA_KV_CACHE_TYPE=q8_0

# Disable cloud features (remote inference and web search).
# OLLAMA_NO_CLOUD=1

# A comma-separated list of models to automatically pull on startup.
# Example: OLLAMA_PULL_MODELS=llama3.2:3b,phi3:mini,all-minilm:22m
# OLLAMA_PULL_MODELS=

####################################################################################
# Version Overrides and Pinning (Optional)
####################################################################################

# By default, the environment uses the latest/alpine tags.
# To pin a component, set its variable to a specific image tag instead.

# Oracle Database Free image tag.
# Example: DB_VERSION_TAG=23.26.2.0

# Oracle REST Data Services (ORDS) image tag.
# Example: ORDS_VERSION_TAG=26.2.2

# Ollama image tag.
# Example: OLLAMA_VERSION_TAG=0.32.12

# Nginx image tag for the HTTPS gateway.
# Example: NGINX_VERSION_TAG=1.27.0-alpine

# Alpine image tag for the temporary setup container.
# Example: ALPINE_VERSION_TAG=3.20
