####################################################################################
# ENVIRONMENT VARIABLES CONFIGURATION
#
# INSTRUCTIONS:
# 1. This file defines the core passwords and settings for your environment.
# 2. To change an optional setting, remove the '#' symbol at the start of the line
#    and provide your value.
# 3. Do NOT put spaces around the equals sign (e.g., use KEY=value, NOT KEY = value).
####################################################################################

####################################################################################
# Compose
####################################################################################

COMPOSE_PATH_SEPARATOR=:

# Defines which Docker Compose files are loaded and merged on startup.
# Choose ONE of the following options by uncommenting it
# if you would like to add Ollama to the environment.

# Option 1: Basic setup Database, ORDS, and Ollama (CPU only - Default)
# COMPOSE_FILE=docker-compose.yml:compose.ollama.yml

# Option 2: Basic setup Database, ORDS, and Ollama (with NVIDIA GPU support)
# COMPOSE_FILE=docker-compose.yml:compose.ollama.yml:compose.ollama.gpu.yml


# The port on host machine used to access the Oracle Database listener.
# HOST_DB_PORT=1521                                   # Default: 1521

# The port on host machine used to access the APEX.
# HOST_ORDS_PORT=8181                                 # Default: 8181

####################################################################################
# Database & ORDS
####################################################################################

# The master password used for SYS, SYSTEM, and PDBADMIN database users.
# IMPORTANT: Oracle requires strong passwords (e.g., minimum 8 characters,
# at least one uppercase letter, one lowercase letter, and one number).
ORACLE_PWD=OraCle#26ai

####################################################################################
# ORDS (Oracle REST Data Services) Connection Settings
####################################################################################

# These settings dictate how ORDS connects to the database. You generally only
# need to change these if you are connecting to an external database instead of
# the one provided in this Docker Compose setup.

# Set to TRUE to enable verbose logging for ORDS. Useful for troubleshooting.
# DEBUG=                                              # Default: FALSE

# The hostname or IP address of the database.
# DBHOST=                                             # Default: db-26ai-free

# The port used to communicate with the database listener.
# DBPORT=                                             # Default: 1521

# The Pluggable Database (PDB) service name where APEX is installed.
# DBSERVICENAME=                                      # Default: FREEPDB1

####################################################################################
# Database Startup Features
####################################################################################

# These settings control advanced database recovery features. For a simple local
# development environment, it is best to leave these as FALSE (commented out)
# to save disk space and resources.

# Set to TRUE to enable Archive Logging (allows for point-in-time recovery).
# ENABLE_ARCHIVELOG=                                  # Default: FALSE

# Set to TRUE to force logging for all database transactions.
# ENABLE_FORCE_LOGGING=                               # Default: FALSE

####################################################################################
# APEX Instance Administration
####################################################################################

# These credentials are used to log into the APEX Administration Service
# (INTERNAL workspace) to manage the entire APEX platform.

# The username for the APEX instance administrator.
# APEX_ADMIN_USER_NAME=                               # Default: ADMIN

# The password for the APEX instance administrator.
# If left commented out, it automatically uses your ORACLE_PWD from above.
# Note: Password must meet Oracle's strong password requirements.
# APEX_ADMIN_USER_PWD=                                # Default: Same as ORACLE_PWD

# The email address associated with the APEX administrator account.
# APEX_ADMIN_USER_EMAIL=

####################################################################################
# Ollama
####################################################################################

# These settings optimize how Large Language Models run on your hardware.
# Tuning these depends heavily on your available RAM/VRAM.

# The maximum context window (in tokens) the model can process at once.
# Note: Larger contexts consume significantly more memory.
# OLLAMA_CONTEXT_LENGTH=                              # Default: 32768

# How long a model stays loaded in memory after the last request.
# '1h' keeps it ready for rapid follow-up prompts during development.
# OLLAMA_KEEP_ALIVE=                                  # Default: 1h

# Enables Flash Attention, which speeds up processing and reduces memory
# usage for large context windows (1 = Enabled, 0 = Disabled).
# OLLAMA_FLASH_ATTENTION=                             # Default: 1

# The number of concurrent requests Ollama will process at the same time.
# Keep this at 1 for local development to prevent memory crashes.
# OLLAMA_NUM_PARALLEL=                                # Default: 1

# The quantization format used to compress the Key-Value cache in memory.
# 'q8_0' offers a great balance between accuracy and memory savings.
# OLLAMA_KV_CACHE_TYPE=                               # Default: q8_0

# A comma-separated list of models to automatically pull on startup.
# Example: OLLAMA_PULL_MODELS=llama3.1:8b,phi3:mini
# OLLAMA_PULL_MODELS=