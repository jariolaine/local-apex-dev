server {
  # Enable HTTP/2 over TLS.
  listen 443 ssl;
  http2 on;
  server_name ollama-api-gateway;

  ssl_certificate     /etc/nginx/ssl/fullChain.cer;
  ssl_certificate_key /etc/nginx/ssl/server.key;
  ssl_protocols       TLSv1.3;

  # Disable the Nginx request-body size limit for large prompts and image uploads.
  client_max_body_size 0;

  location / {
    proxy_pass ${OLLAMA_BASE_URL};
    proxy_http_version 1.1;

    # Pass standard headers.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";

    # Optimized for streaming LLM responses.
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;
  }
}